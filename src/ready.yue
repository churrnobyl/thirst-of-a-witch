import 'macros' as { $ }
import lib.modutil.mod as mod
import lib.incantations as incantations

_data =
  incant_id: 'gt-severe-thirst'
  weapons: {}

langmap = (str) ->
  ks = ['en', 'de', 'el', 'es', 'fr', 'it', 'ja', 'ko', 'pl', 'pt-BR', 'ru', 'tr', 'uk', 'zh-CN', 'zh-TW']
  m = {}
  m[k] = str for k in *ks
  m

$debug_log 'adding incantation'
incantations.addIncantation
  Id: _data.incant_id
  Name: langmap 'Thirst of a Witch'
  Description: langmap '{#Emph}Enchant each of the Nocturnal Arms{#Prev}, causing them to suffer from Grave Thirst each night.'
  FlavorText: langmap 'Try as you might, you cannot quench their thirst.'
  WorldUpgradeData:
    -- once you have completed the requirements, no reason not to show it
    AlwaysRevealImmediately: true
    Icon: "GUI\\Screens\\CriticalItemShop\\Icons\\cauldron_bones"
    Cost:
      OreFSilver: 10
      MixerIBoss: 1
      MixerQBoss: 1
    GameStateRequirements:
      * {
        Path: { 'GameState', 'EnemyKills', 'Chronos' }
        Comparison: '>='
        Value: 3
      }
      * {
        Path: { 'GameState', 'EnemyKills', 'TyphonHead' }
        Comparison: '>='
        Value: 2
      }
    PreRevealVoiceLines:
      PreLineWait: 0.25
      ObjectType: 'NPC_Hecate_01'
      * { Cue: '/VO/Hecate_0179', Text: 'Now say the words.', PreLineAnim: 'Hecate_Hub_Affirm' }
    IncantationVoiceLines:
      * {
        PreLineWait: 0.3
        { Cue: '/VO/Melinoe_0531', Text: "{#Emph}Fire and Earth, between heaven and hell, \n {#Emph}Make manifest my thoughts; complete my spell." }
      }
    RevealReactionVoiceLines:
      * { GlobalVoiceLines: 'CauldronReactionFollowUpVoiceLines' }
$debug_log 'incantation added'

make_thirsty = ->
  $debug_log 'make_thirsty: enter'

  thirsty = {}
  weps = GetEligibleMeleeWeapons!

  nweps = config.num_weapons
  if nweps == 0
    nweps = 6

  count = math.min #weps, nweps
  for i = 1, count
    idx = math.random 1, #weps
    thirsty[] = weps[idx].Name
    $debug_log 'make_thirsty: chose ' .. weps[idx].Name
    table.remove weps, idx

  thirsty

-- we're in a hub if `CurrentHubRoom` exists.
mod.Path.Wrap 'DeathAreaRoomTransition', (fn, source, args) ->
  $debug_log 'DeathAreaRoomTransition: enter'
  r = fn source, args

  unless incantations.isIncantationEnabled _data.incant_id
    $debug_log 'DeathAreaRoomTransition: incantation not enabled'
    return r

  unless CurrentHubRoom
    $debug_log 'DeathAreaRoomTransition: CurrentHubRoom not defined'
    return r

  unless #_data.weapons > 0
    $debug_log 'DeathAreaRoomTransition: make_thirsty for ' .. tostring(config.num_weapons)
    _data.weapons = make_thirsty!

  $debug_log 'DeathAreaRoomTransition: exit'
  r

-- IsBonusUnusedWeapon checks if you're using a weapon with thirst enabled.
mod.Path.Wrap 'IsBonusUnusedWeapon', (fn, weapon) ->
  $debug_log 'IsBonusUnusedWeapon: enter'
  unless incantations.isIncantationEnabled _data.incant_id
    $debug_log 'IsBonusUnusedWeapon: incantation not enabled'
    return fn weapon

  unless #_data.weapons > 0
    $debug_log 'IsBonusUnusedWeapon: forcing thirsty generation'
    _data.weapons = make_thirsty!

  ok = weapon in _data.weapons
  $debug_log 'IsBonusUnusedWeapon: ' .. weapon .. ' = ' .. tostring(ok)
  ok

mod.Path.Wrap 'StartNewRun', (fn, source, args) ->
  $debug_log 'StartNewRun: enter'
  r = fn source, args

  unless incantations.isIncantationEnabled _data.incant_id
    $debug_log 'StartNewRun: incantation not enabled'
    return r

  got = false
  for k, _ in pairs CurrentRun.Hero.Weapons
    got = k in _data.weapons
    $debug_log 'StartNewRun: player weapon found ' .. k .. ' in thirsty? ' .. tostring(got)
    break if got

  unless got
    for v in *_data.weapons
       $debug_log 'StartNewRun: player is not using ' .. v
    return r

  trait = GameState.WorldUpgrades.WorldUpgradeUnusedWeaponBonusT2 and 'UnusedWeaponBonusTrait2' or 'UnusedWeaponBonusTrait'
  $debug_log 'StartNewRun: has trait ' .. trait .. '? ' .. tostring(HeroHasTrait(trait))
  unless HeroHasTrait trait
    AddTrait CurrentRun.Hero, trait
    $debug_log 'StartNewRun: added trait'

  -- reset live_data for next hub
  _data.weapons = {}
  r
