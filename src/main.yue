import 'macros' as { $ }
import game, mods from rom

-- scaffolding
_ENV, envy = mods['LuaENVY-ENVY'].setup _ENV
envy.import_as_fallback game

lib =
  modutil: mods['SGG_Modding-ModUtil']
  reload:  mods['SGG_Modding-ReLoad']
  chalk:   mods['SGG_Modding-Chalk']
  incantations: mods['BlueRaja-IncantationsAPI']

envy.private.lib = lib
envy.public.config = lib.chalk.auto 'config.lua'

loader = lib.reload.auto_single!
-- /scaffolding

on_ready = ->
  unless config.enabled
    return

  mod = lib.modutil.mod.Mod.Register(_PLUGIN.guid)
  $debug_log 'enabled'
  envy.import 'ready.lua'
  nil

on_reload = ->
  unless config.enabled
    return

  $debug_log 'reloading'
  envy.import 'reload.lua'
  nil

lib.modutil.once_loaded.game ->
  loader.load on_ready, on_reload
  nil
